{
  "name": "ebook-publishing-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-gest\u00fctzte Autorenplattform (privater Pilot)",
  "engines": {
    "node": "26.13.0",
    "npm": ">=11.20.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "env:up": "node scripts/bootstrap-local.mjs up",
    "env:down": "node scripts/bootstrap-local.mjs down",
    "test:contracts": "vitest run tests/contracts",
    "cli": "node --env-file-if-exists=.env.local --import tsx scripts/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-placeholder": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "fflate": "0.8.3",
    "next": "16.4.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
